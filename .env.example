# ---- copy to `.env` on the bot server and fill in (NEVER commit .env) --------

# Public LinkHash Data API — the SAME interface competitors use (fairness).
# Create a key at https://link-hash.com/developers/  (format: lhx_live_...).
# The bot needs a tier whose daily quota covers ~a few thousand calls/day.
LHX_API_BASE=https://link-hash.com
LHX_API_KEY=

# ---- strategy rails ----------------------------------------------------------
STRAT_ENABLED=0        # master switch. 0 = do nothing live.
STRAT_DRY_RUN=1        # 1 = detect + log only (no orders). Flip to 0 for real.
STRAT_BET_USDC=5       # notional per bet
STRAT_MAX_EXPOSURE=50  # max simultaneous open real notional
STRAT_MAX_LOSS=30      # cumulative realized loss -> bot self-disables (kill-switch)
STRAT_COINS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE
STRAT_VENUE=polymarket
# STRAT_INTERVAL=6       # fast poll (secs) near a window close
# STRAT_INTERVAL_IDLE=30 # slow poll when all windows are far from their band
# STRAT_FIRE_BAND=45     # act within (n-BAND, n] seconds-left
# STRAT_MIN_TLEFT=15     # need >= this many secs left to fill
# STRAT_STALE_SEC=20     # skip if chainlink/orderbook older than this

# ---- Telegram announcements (optional; public group) -------------------------
# Create a bot with @BotFather -> token. Add it to the group, then get the
# group's chat id (e.g. via @RawDataBot or the getUpdates API). Leave blank = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_DRY=0   # 1 = also announce dry-run (simulated) bets to the group

# ---- Polymarket (only needed to go LIVE) -------------------------------------
# The EOA private key that controls your Polymarket wallet (0x...).
PM_PRIVATE_KEY=
# Your Polymarket funding (proxy) wallet address that holds the USDC.
PM_FUNDER=
# Signature type: 1 = browser/MetaMask proxy wallet, 2 = email/magic wallet.
PM_SIG_TYPE=2
PM_HOST=https://clob.polymarket.com
PM_CHAIN_ID=137
