# ---- copy to `.env` on the bot server and fill in (NEVER commit .env) --------

# LIVE SIGNALS are Polymarket-direct (RTDS websocket + Gamma + public CLOB) — no
# key needed for those. The LinkHash key is used ONLY for settlement P&L
# accounting (post-hoc observation), so a FREE-tier key is plenty (~700/day).
LHX_API_BASE=https://link-hash.com
LHX_API_KEY=

# ---- strategy rails ----------------------------------------------------------
STRAT_ENABLED=0        # master switch. 0 = do nothing live.
STRAT_DRY_RUN=1        # 1 = detect + log only (no orders). Flip to 0 for real.
STRAT_BET_USDC=1       # notional per bet
STRAT_MAX_EXPOSURE=8   # max simultaneous open real notional
STRAT_MAX_LOSS=5       # cumulative realized loss -> bot self-disables (kill-switch)
STRAT_COINS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE
STRAT_VENUE=polymarket
# STRAT_INTERVAL=5        # fast poll (secs) near a window close
# STRAT_INTERVAL_IDLE=30  # slow poll when all windows are far from their band
# STRAT_FIRE_BAND=45      # act within (n-BAND, n] seconds-left
# STRAT_MIN_TLEFT=15      # need >= this many secs left to fill
# STRAT_STALE_SEC=20      # skip if the RTDS price is older than this

# ---- Telegram announcements (optional; public group) -------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_DRY=0   # 1 = also announce dry-run (simulated) bets to the group

# ---- Polymarket (only needed to go LIVE) -------------------------------------
PM_PRIVATE_KEY=
PM_FUNDER=0x4aA1e82f2C739aE711A69f7998D3906a8f902498
PM_SIG_TYPE=1          # 1 = browser/MetaMask proxy wallet, 2 = email/magic wallet
PM_HOST=https://clob.polymarket.com
PM_CHAIN_ID=137
